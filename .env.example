# Copy to .env.local. Never commit .env.local.

# Django API base URL (server-side fetches)
API_URL=http://localhost:8000
# Same URL for browser-side fetches (inlined into the client bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Official social accounts (icons show "coming soon" until set)
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
